{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@hexald/shared": ["./packages/shared/src/index.ts"],
      "@hexald/content": ["./packages/content/src/index.ts"],
      "@hexald/game-core": ["./packages/game-core/src/index.ts"],
      "@hexald/db": ["./packages/db/src/index.ts"]
    }
  }
}
