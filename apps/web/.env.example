# Public AdSense publisher client (ca-pub-…). Leave empty to skip script load.
# Never commit a real production secret here — the client ID is public but
# stays centralized via runtimeConfig.
NUXT_PUBLIC_ADSENSE_CLIENT_ID=

# Canonical site URL (SEO : sitemap, OG, canonical). No trailing slash.
NUXT_PUBLIC_SITE_URL=https://hexald.com

# Firebase Auth (client — public config from Firebase Console → Project settings)
# Restart `pnpm dev:web` after changing these.
#
# Mobile / LAN : ouvre http://IP:9089 (PAS https — le serveur de dev est HTTP).
# Ajoute l’IP dans Firebase → Authentication → Settings → Authorized domains.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Optional: override API proxy target for the Nuxt /backend/** route
# NUXT_API_PROXY_TARGET=http://127.0.0.1:9088
