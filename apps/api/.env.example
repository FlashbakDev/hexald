ENV="development"
PORT="9088"
DATABASE_URL="postgresql://hexald:hexald@127.0.0.1:5432/hexald"
SESSION_SECRET="dev-only-session-secret-change-me-32b"
CORS_ORIGINS="http://127.0.0.1:9089,http://localhost:9089"

# Firebase Admin (from service account JSON — never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for newlines inside the quoted key
FIREBASE_PRIVATE_KEY=

# Support reports (Resend) → https://resend.com/api-keys
# 1. Create an API key
# 2. Domains → verify hexald.com (DNS)
# 3. SUPPORT_FROM must use that verified domain
# Without RESEND_API_KEY: logs only in dev, 503 in production
RESEND_API_KEY=
SUPPORT_TO=contact@hexald.com
SUPPORT_FROM=Hexald <noreply@hexald.com>
